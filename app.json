{
  "expo": {
    "name": "نوبین",
    "slug": "nobin",
    "scheme": "nobin",
    "version": "2.1.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router"
    ],
    "android": {
      "package": "ir.nobin.app",
      "versionCode": 20101,
      "permissions": [],
      "softwareKeyboardLayoutMode": "resize",
      "usesCleartextTraffic": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F7F2E8"
      },
      "allowBackup": false
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "router": {
        "origin": false
      }
    },
    "icon": "./assets/icon.png"
  }
}
