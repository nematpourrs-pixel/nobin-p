{
  "expo": {
    "name": "نوبین",
    "slug": "nobin",
    "scheme": "nobin",
    "version": "2.0.3",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": ["expo-router"],
    "android": {
      "package": "ir.nobin.app",
      "versionCode": 20003,
      "permissions": ["POST_NOTIFICATIONS"],
      "softwareKeyboardLayoutMode": "resize",
      "usesCleartextTraffic": false,
      "adaptiveIcon": {"backgroundColor": "#F6F8F9"}
    },
    "web": {"bundler": "metro"},
    "extra": {"router": {"origin": false}}
  }
}
