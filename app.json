{
  "expo": {
    "name": "نوبین",
    "slug": "nobin",
    "scheme": "nobin",
    "version": "2.2.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "نوبین برای انتخاب تصویر کسب‌وکار، خدمات و کارکنان به تصاویر انتخابی شما دسترسی دارد.",
          "microphonePermission": false
        }
      ]
    ],
    "android": {
      "package": "ir.nobin.app",
      "versionCode": 20201,
      "permissions": [],
      "softwareKeyboardLayoutMode": "resize",
      "usesCleartextTraffic": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F7F2E8"
      },
      "allowBackup": false
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "router": {
        "origin": false
      },
      "market": "CAFE_BAZAAR",
      "commercialMode": "FREE"
    },
    "icon": "./assets/icon.png"
  }
}
